let handler = async (m, { conn, text, isAdmin }) => {
  if (!isAdmin) return m.reply(`╭─🐉 *『 𝗦𝗢𝗡 𝗚𝗢𝗞𝗨 𝗣𝗥𝗘𝗠 』* 🐉─╮
│ 😡 *SIN PERMISOS*
│
│ *Solo admins pueden cambiar el mensaje*
╰─────────────────🐉`);

  let chat = global.db.data.chats[m.chat];

  if (!text) {
    chat.welcomeText = null;
    return m.reply(`╭─🐉 *『 𝗦𝗢𝗡 𝗚𝗢𝗞𝗨 𝗣𝗥𝗘𝗠 』* 🐉─╮
│ ✅ *BIENVENIDA RESTAURADA*
│
│ *Volvio al mensaje DBZ por defecto*
│ *Usa.setwelcome <texto> para personalizar*
╰─────────────────🐉`);
  }

  chat.welcomeText = text;
  m.reply(`╭─🐉 *『 𝗦𝗢𝗡 𝗚𝗢𝗞𝗨 𝗣𝗥𝗘𝗠 』* 🐉─╮
│ 💥 *MENSAJE DE BIENVENIDA GUARDADO*
╰─────────────────🐉

╭─「 𝗣𝗥𝗘𝗩𝗜𝗦𝗨𝗔𝗟𝗜𝗭𝗔𝗖𝗜𝗢𝗡 」─🐉─╮
│ ${text}
╰─────────────────🐉

*Variables:* @user @name @group @desc %users @action @date
> *"Un nuevo guerrero se acerca"*`);
}

handler.help = ['setwelcome <texto>'];
handler.tags = ['group'];
handler.command = ['setwelcome'];
handler.admin = true;
handler.group = true;

export default handler;